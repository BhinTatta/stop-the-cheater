# Optional. The game is fully playable and deployable with these unset — the
# /api/stats and /api/event endpoints then just report nothing and the play
# counter stays hidden. Set both to switch the counters on (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Absolute origin used for the link-preview (Open Graph) tags at
# build time, e.g. https://stopthecheater.example. Vercel and Netlify set
# their own equivalents automatically, so this is only needed elsewhere.
SITE_URL=
